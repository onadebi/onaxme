---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "About";
---

<BaseLayout title={title} pageName="about">
  <div class="bg-zinc-50 dark:bg-[#141414] py-16 mb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block py-1 px-3 rounded-full bg-white dark:bg-[#1a1a1a] text-[var(--color-primary)] dark:text-[var(--color-primary-light)] text-sm font-semibold tracking-wide mb-4 shadow-sm border border-zinc-200 dark:border-zinc-800">
        WHO'S BEHIND ALL THIS
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-6">
        About <span class="text-[var(--color-primary)] dark:text-[var(--color-primary-light)]">Me</span>
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto">
        My journey, education, and credentials in the world of software engineering.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="space-y-12">
      <!-- Bio -->
      <section class="bg-white dark:bg-[#1a1a1a] rounded-3xl p-8 md:p-10 shadow-sm border border-zinc-100 dark:border-zinc-800">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center">
          <span class="w-8 h-8 rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] flex items-center justify-center mr-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          </span>
          Professional Summary
        </h2>
        <div class="text-zinc-600 dark:text-zinc-400 text-lg space-y-4">
          <p>
            I am a Senior full-stack Software developer with 10 years' experience building scalable enterprise systems. 
            I have proven ability to implement event-based microservices and collaborate directly with both technical and 
            non-technical stakeholders to deliver expected software solutions.
          </p>
          <p>
            I am skilled in problem-solving, detail-oriented with good communications, interpersonal and 
            collaborative skills working across multiple delivery units. I excel at understanding and translating 
            business requirements to working prototypes.
          </p>
        </div>
      </section>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Education -->
        <section class="bg-white dark:bg-[#1a1a1a] rounded-3xl p-8 shadow-sm border border-zinc-100 dark:border-zinc-800">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center">
            <span class="w-8 h-8 rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] flex items-center justify-center mr-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path></svg>
            </span>
            Education
          </h2>
          
          <div class="space-y-6">
            <div class="relative pl-6 border-l-2 border-zinc-200 dark:border-zinc-700">
              <div class="absolute w-3 h-3 bg-[var(--color-primary)] rounded-full -left-[7px] top-1.5 ring-4 ring-white dark:ring-[#1a1a1a]"></div>
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-1">
                <h3 class="font-bold text-zinc-900 dark:text-white text-lg">Post-Graduate Certificate</h3>
                <span class="text-sm font-medium text-[var(--color-primary)] dark:text-[var(--color-primary-light)] bg-[var(--color-primary)]/10 px-2 py-0.5 rounded-full mt-1 sm:mt-0 w-max">August 2024</span>
              </div>
              <p class="font-medium text-zinc-700 dark:text-zinc-300">Software and Information Systems Testing (Distinction)</p>
              <p class="text-sm text-zinc-500 dark:text-zinc-500 mt-1">Fanshawe College, London, Ontario</p>
            </div>

            <div class="relative pl-6 border-l-2 border-zinc-200 dark:border-zinc-700">
              <div class="absolute w-3 h-3 bg-zinc-400 dark:bg-zinc-600 rounded-full -left-[7px] top-1.5 ring-4 ring-white dark:ring-[#1a1a1a]"></div>
              <h3 class="font-bold text-zinc-900 dark:text-white text-lg mb-1">Bachelor of Science</h3>
              <p class="font-medium text-zinc-700 dark:text-zinc-300">Physics</p>
              <p class="text-sm text-zinc-500 dark:text-zinc-500 mt-1">University of Benin, Edo, Nigeria</p>
            </div>
          </div>
        </section>

        <!-- Volunteering -->
        <section class="bg-white dark:bg-[#1a1a1a] rounded-3xl p-8 shadow-sm border border-zinc-100 dark:border-zinc-800">
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center">
            <span class="w-8 h-8 rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] flex items-center justify-center mr-3">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </span>
            Volunteering
          </h2>
          
          <div class="relative pl-6 border-l-2 border-[var(--color-primary)]/30">
            <div class="absolute w-3 h-3 bg-[var(--color-primary)] rounded-full -left-[7px] top-1.5 animate-pulse"></div>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-1">
              <h3 class="font-bold text-zinc-900 dark:text-white text-lg">Thriving Hand-In-Hand Career</h3>
              <span class="text-sm font-medium text-[var(--color-primary)] dark:text-[var(--color-primary-light)] bg-[var(--color-primary)]/10 px-2 py-0.5 rounded-full mt-1 sm:mt-0 w-max">July 2023 - Present</span>
            </div>
            <p class="font-medium text-zinc-700 dark:text-zinc-300">Mentor (Software Development)</p>
          </div>
        </section>
      </div>

      <!-- Certifications -->
      <section class="bg-white dark:bg-[#1a1a1a] rounded-3xl p-8 md:p-10 shadow-sm border border-zinc-100 dark:border-zinc-800">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center">
          <span class="w-8 h-8 rounded-lg bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] flex items-center justify-center mr-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
          </span>
          Certifications and Awards
        </h2>
        
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <li class="flex flex-col p-4 rounded-xl bg-zinc-50 dark:bg-[#141414] border border-zinc-100 dark:border-zinc-800 hover:border-[var(--color-primary)]/30 transition-colors">
            <span class="font-semibold text-zinc-900 dark:text-zinc-200 mb-1">Microsoft GH-300: GitHub Copilot</span>
            <span class="text-sm text-[var(--color-primary)] dark:text-[var(--color-primary-light)] font-medium">December 2025</span>
          </li>
          <li class="flex flex-col p-4 rounded-xl bg-zinc-50 dark:bg-[#141414] border border-zinc-100 dark:border-zinc-800 hover:border-[var(--color-primary)]/30 transition-colors">
            <span class="font-semibold text-zinc-900 dark:text-zinc-200 mb-1">Fanshawe College President's Honour Roll</span>
            <span class="text-sm text-[var(--color-primary)] dark:text-[var(--color-primary-light)] font-medium">August 2024</span>
          </li>
          <li class="flex flex-col p-4 rounded-xl bg-zinc-50 dark:bg-[#141414] border border-zinc-100 dark:border-zinc-800 hover:border-[var(--color-primary)]/30 transition-colors">
            <span class="font-semibold text-zinc-900 dark:text-zinc-200 mb-1">Microsoft Certified: Azure Fundamentals</span>
            <span class="text-sm text-[var(--color-primary)] dark:text-[var(--color-primary-light)] font-medium">January 2021</span>
          </li>
          <li class="flex flex-col p-4 rounded-xl bg-zinc-50 dark:bg-[#141414] border border-zinc-100 dark:border-zinc-800 hover:border-[var(--color-primary)]/30 transition-colors">
            <span class="font-semibold text-zinc-900 dark:text-zinc-200 mb-1">Microsoft Certified Professional (70-480)</span>
            <span class="text-sm text-[var(--color-primary)] dark:text-[var(--color-primary-light)] font-medium">April 2018</span>
          </li>
          <li class="flex flex-col md:col-span-2 p-4 rounded-xl bg-zinc-50 dark:bg-[#141414] border border-zinc-100 dark:border-zinc-800 hover:border-[var(--color-primary)]/30 transition-colors">
            <span class="font-semibold text-zinc-900 dark:text-zinc-200 mb-1">Testathon World Tour (Best Runner Up Software Quality Assurance Testing)</span>
            <span class="text-sm text-[var(--color-primary)] dark:text-[var(--color-primary-light)] font-medium">June 2016</span>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
