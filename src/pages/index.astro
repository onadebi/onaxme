---
const title: string = "Onax - Building things";
import FloatingBadge from "../components/FloatingBadge.astro";
import QuickSkillSection from "../components/QuickSkillSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout title={title} pageName="home">
  <!-- <h3 style="background-color:var(--green);">Onaefe's blog</h3> -->
    <!-- Hero Section -->
  <section class="relative pt-16 pb-20 lg:pt-24 lg:pb-28 overflow-hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-12">
      <!-- Text Content -->
      <div class="flex-1 text-center lg:text-left z-10">
        <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--green);"></span>
        <span class="inline-block py-1 px-3 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] text-sm font-semibold tracking-wide mb-4">
          Available for new projects
        </span>
        <h1 class="text-5xl lg:text-6xl font-bold text-zinc-900 dark:text-white leading-tight mb-6">
          i<span class="text-[var(--color-primary)] dark:text-[var(--color-primary-light)]">Build</span><br/>Systems!
        </h1>
        <p class="text-lg text-zinc-600 dark:text-zinc-400 mb-8 max-w-2xl mx-auto lg:mx-0">
          I build scalable enterprise systems. With over 10 years of experience, I
          specialize in event-based microservices, automation, and delivering
          robust software solutions that bridge the gap between technical
          complexity and business needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="/projects" class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-full shadow-sm text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] transition-all">
            VIEW MY WORK
            <svg class="ml-2 -mr-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-3 border-2 border-zinc-300 dark:border-zinc-700 text-base font-medium rounded-full text-zinc-700 dark:text-zinc-300 hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary-light)] dark:hover:border-[var(--color-primary-light)] transition-all">
            Hire Me
          </a>
        </div>
      </div>
      
      <FloatingBadge />
    </div>
  </section>

  <!-- Banner Strip -->
  <div class="bg-[var(--color-primary)] py-6 w-full overflow-hidden">
    <div class="flex gap-8 items-center justify-center text-white/90 text-sm md:text-base font-semibold tracking-wider flex-wrap px-4">
      <span class="flex items-center gap-2">✦ Microservices</span>
      <span class="flex items-center gap-2">✦ QA Automation</span>
      <span class="flex items-center gap-2">✦ Cloud Architecture</span>
      <span class="flex items-center gap-2 hidden sm:flex">✦ API Integrations</span>
    </div>
  </div>

  <QuickSkillSection />
</BaseLayout>
