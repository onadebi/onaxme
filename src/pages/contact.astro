---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "About";
---

<BaseLayout title={title} pageName="contact">
  <div class="bg-zinc-50 dark:bg-[#141414] py-16 mb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block py-1 px-3 rounded-full bg-white dark:bg-[#1a1a1a] text-[var(--color-primary)] dark:text-[var(--color-primary-light)] text-sm font-semibold tracking-wide mb-4 shadow-sm border border-zinc-200 dark:border-zinc-800">
        CONTACT INFO
      </span>
      <h1 class="text-4xl md:text-5xl font-bold text-zinc-900 dark:text-white mb-6">
        Let's Work <span class="text-[var(--color-primary)] dark:text-[var(--color-primary-light)]">Together</span>
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto hidden">
        I'm available for freelance work and full-time opportunities. Let's discuss your project!
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Contact Information -->
      <div class="lg:col-span-1 bg-white dark:bg-[#1a1a1a] rounded-3xl p-8 shadow-sm border border-zinc-100 dark:border-zinc-800 h-max hidden">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-8">Contact Info</h2>
        
        <div class="space-y-6">
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] rounded-full flex items-center justify-center mr-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <p class="text-sm font-medium text-zinc-500 dark:text-zinc-500 uppercase tracking-wider mb-1">Email</p>
              <a href="mailto:onaefee@yahoo.com" class="text-zinc-900 dark:text-zinc-200 font-semibold hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary-light)] transition-colors break-all">me@gmail.com</a>
            </div>
          </div>
          
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] rounded-full flex items-center justify-center mr-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <p class="text-sm font-medium text-zinc-500 dark:text-zinc-500 uppercase tracking-wider mb-1">Phone</p>
              <a href="tel:08032278740" class="text-zinc-900 dark:text-zinc-200 font-semibold hover:text-[var(--color-primary)] dark:hover:text-[var(--color-primary-light)] transition-colors">08033333333</a>
            </div>
          </div>
          
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] rounded-full flex items-center justify-center mr-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <p class="text-sm font-medium text-zinc-500 dark:text-zinc-500 uppercase tracking-wider mb-1">Location</p>
              <p class="text-zinc-900 dark:text-zinc-200 font-semibold">Internet</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-3 bg-white dark:bg-[#1a1a1a] rounded-3xl p-8 md:p-10 shadow-sm border border-zinc-100 dark:border-zinc-800">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-8">Send a Message</h2>
        <form action="#" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
              <label for="name" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your Name" class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 placeholder-zinc-400 dark:placeholder-zinc-600 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-shadow outline-none" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Email</label>
              <input type="email" id="email" name="email" required placeholder="your.email@example.com" class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 placeholder-zinc-400 dark:placeholder-zinc-600 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-shadow outline-none" />
            </div>
          </div>
          <div class="mb-6">
            <label for="message" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Message</label>
            <textarea id="message" name="message" rows="6" required placeholder="How can I help you?" class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-zinc-200 placeholder-zinc-400 dark:placeholder-zinc-600 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-shadow outline-none resize-y"></textarea>
          </div>
          <button type="submit" class="w-full inline-flex justify-center items-center px-8 py-4 border border-transparent text-lg font-bold rounded-xl shadow-sm text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-primary)] dark:focus:ring-offset-[#1a1a1a] transition-colors cursor-pointer">
            Send Message
            <svg class="ml-2 -mr-1 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>
<script>
    document.querySelector('form')?.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(event.target as HTMLFormElement);
      const name = formData.get('name');
      const email = formData.get('email');
      const message = formData.get('message');

      // send the form data to default email client //
      const mailtoLink = `mailto:${'no-reply@onadebi.com'}?subject=New Message from ${name}&body=${encodeURIComponent(JSON.stringify(message))}&sender=${encodeURIComponent(String(email))}`;
      window.location.href = mailtoLink;

      alert(`Thank you for your message, ${name}! Please launch your email client to send the message.`);
    });
</script>