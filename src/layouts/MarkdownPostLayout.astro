---
import BaseLayout from './BaseLayout.astro';

const {data}  = Astro.props;
---

<BaseLayout title={data.data.title} description={data.data.description}>
  <section style="max-width:80ch; margin:auto;">  
    <h1>{data.data.title}</h1>
    <p>{data.data.pubDate.toString().slice(0, 10)}</p>
    <p><em>{data.data.description}</em></p>
    <p>Written by: {data.data.author}</p>
    <img src={data.data.image.url} width="300" style="width:100%; object-fit: cover; max-height: 300px;" alt={data.data.image.alt} />
    <slot />
  </section>
</BaseLayout>
