---
interface Props {
  role: string;
  company: string;
  date: string;
  location?: string;
  responsibilities: string[];
}

const { role, company, date, location, responsibilities } = Astro.props;
---
<div class="bg-white dark:bg-[#1a1a1a] rounded-2xl shadow-sm border border-zinc-100 dark:border-zinc-800 p-6 md:p-8 hover:-translate-y-1 transition-transform duration-300">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 gap-2">
    <h3 class="font-bold text-xl text-zinc-900 dark:text-white leading-tight">{role}</h3>
    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-primary)]/10 text-[var(--color-primary)] dark:text-[var(--color-primary-light)] whitespace-nowrap">
      {date}
    </span>
  </div>
  
  <div class="mb-4">
    <p class="text-[var(--color-primary)] dark:text-[var(--color-primary-light)] font-semibold text-lg">{company}</p>
    {location && <p class="text-sm text-zinc-500 dark:text-zinc-400 font-medium flex items-center mt-1">
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      {location}
    </p>}
  </div>
  
  <ul class="space-y-3">
    {responsibilities.map((item) => (
      <li class="relative pl-6 text-sm text-zinc-600 dark:text-zinc-400">
        <span class="absolute left-0 top-0.5 w-4 h-4 text-[var(--color-primary)] dark:text-[var(--color-primary-light)]">
          <svg fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
        </span>
        {item}
      </li>
    ))}
  </ul>
</div>
