---
import appsettings from '../configs/appsettings';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="sticky top-0 z-50 bg-white/80 dark:bg-[#0a0a0a]/90 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
          <span class="text-[var(--color-primary)]">{appsettings.appName}</span><span class="text-[var(--green)] text-lg">&lt;</span>Dev<span class="text-[var(--green)] text-lg">/&gt;</span>
        </a>
      </div>
      
      {/* Desktop Menu */}
      <nav class="hidden md:flex space-x-8">
        <a href="/" class="text-sm font-medium text-zinc-600 hover:text-[var(--color-primary)] dark:text-zinc-400 dark:hover:text-[var(--color-primary-light)] transition-colors">Home</a>
        <a href="/experience" class="text-sm font-medium text-zinc-600 hover:text-[var(--color-primary)] dark:text-zinc-400 dark:hover:text-[var(--color-primary-light)] transition-colors">Experience</a>
        <a href="/projects" class="text-sm font-medium text-zinc-600 hover:text-[var(--color-primary)] dark:text-zinc-400 dark:hover:text-[var(--color-primary-light)] transition-colors">Projects</a>
        <a href="/about" class="text-sm font-medium text-zinc-600 hover:text-[var(--color-primary)] dark:text-zinc-400 dark:hover:text-[var(--color-primary-light)] transition-colors">About</a>
        <a href="/blog" class="text-sm font-medium text-zinc-600 hover:text-[var(--color-primary)] dark:text-zinc-400 dark:hover:text-[var(--color-primary-light)] transition-colors">Blog</a>
        <a href="/contact" class="text-sm font-medium text-zinc-600 hover:text-[var(--color-primary)] dark:text-zinc-400 dark:hover:text-[var(--color-primary-light)] transition-colors">Contact</a>
      </nav>

      <div class="flex items-center space-x-4">
        <a href="https://github.com/onadebi" target="_blank" rel="noopener noreferrer" class="hidden sm:block text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white transition-colors">
          <span class="sr-only">GitHub</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        </a>
        <a href="https://linkedin.com/in/onaefe" target="_blank" rel="noopener noreferrer" class="hidden sm:block text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-white transition-colors">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
        </a>
        <ThemeToggle />
        
        {/* Mobile menu button */}
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-md text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors cursor-pointer" aria-label="Toggle menu">
          <svg class="menu-icon-open h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="menu-icon-close h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Mobile Menu Dropdown */}
  <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-[#0a0a0a]/95 backdrop-blur-xl">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 hover:text-[var(--color-primary)] dark:text-white dark:hover:text-[var(--color-primary-light)] hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">Home</a>
      <a href="/experience" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 hover:text-[var(--color-primary)] dark:text-white dark:hover:text-[var(--color-primary-light)] hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">Experience</a>
      <a href="/projects" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 hover:text-[var(--color-primary)] dark:text-white dark:hover:text-[var(--color-primary-light)] hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">Projects</a>
      <a href="/about" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 hover:text-[var(--color-primary)] dark:text-white dark:hover:text-[var(--color-primary-light)] hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">About</a>
      <a href="/blog" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 hover:text-[var(--color-primary)] dark:text-white dark:hover:text-[var(--color-primary-light)] hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">Blog</a>
      <a href="/contact" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 hover:text-[var(--color-primary)] dark:text-white dark:hover:text-[var(--color-primary-light)] hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">Contact</a>
    </div>
    <div class="pt-4 pb-3 border-t border-zinc-200 dark:border-zinc-800">
      <div class="flex items-center px-5 space-x-4">
        <a href="https://github.com/onadebi" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors">
          <span class="sr-only">GitHub</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
        </a>
        <a href="https://linkedin.com/in/onaefe" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors">
          <span class="sr-only">LinkedIn</span>
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    
    if (btn && menu) {
      // Remove old listeners to prevent duplicates on view transitions
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        const iconOpen = newBtn.querySelector('.menu-icon-open');
        const iconClose = newBtn.querySelector('.menu-icon-close');
        if (iconOpen && iconClose) {
          iconOpen.classList.toggle('hidden');
          iconOpen.classList.toggle('block');
          iconClose.classList.toggle('hidden');
          iconClose.classList.toggle('block');
        }
      });
    }
  }

  // Setup on initial load
  setupMobileMenu();
  
  // Setup after client-side navigation
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
