---
interface IProps{
    title: string;
    tags: string[];
    url: string;
    date: Date;
    image?: string;
    description?: string;
}
// const {frontmatter} = Astro.props;
const post = Astro.props as IProps;
---

    <!-- <a href={post.url}>{post.title}</a>&nbsp;- <span>{post.tags.map((tag: string)=> <i><a href={`/blog/tags/${tag.toLowerCase()}`}>{tag}</a>,&nbsp;</i>)}</span> -->
    
    <section class="group bg-white dark:bg-[#1a1a1a] rounded-2xl shadow-sm border border-zinc-100 dark:border-zinc-800 overflow-hidden flex flex-col hover:-translate-y-1 transition-transform duration-300">
        <a href={post.url}>
              {post.image && (
                <div class="relative h-48 w-full overflow-hidden">
                  <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
              )}
              <div class="p-6 flex flex-col flex-grow">
                <time datetime={post.date?.toISOString()} class="text-sm font-medium text-[var(--color-primary)] dark:text-[var(--color-primary-light)] mb-2">
                  {post.date ? post.date.toLocaleDateString('en-us', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  }) : null}
                </time>
                <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3 group-hover:text-[var(--color-primary)] dark:group-hover:text-[var(--color-primary-light)] transition-colors">
                  {post.title}
                </h2>
                <p class="text-zinc-600 dark:text-zinc-400 mb-6 flex-grow">
                  {post.description}
                </p>
              </div>
            </a>
                {post.tags && post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-auto pt-4 border-t border-zinc-100 dark:border-zinc-800 p-4">
                    {post.tags.map((tag: string) => (
                        <a href={`/blog/tags/${tag.toLowerCase()}`}>
                            <span class="text-xs font-medium text-zinc-500 dark:text-zinc-500 uppercase tracking-wider">#{tag}</span>
                        </a>
                    ))}
                  </div>
                )}
    </section>